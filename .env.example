# Copia este archivo a .env (docker-compose) o captura estas variables en Railway.

# --- Base de datos (solo docker-compose; en Railway usa ${{Postgres.DATABASE_URL}}) ---
POSTGRES_DB=paradise
POSTGRES_USER=paradise
POSTGRES_PASSWORD=cambia-esta-contraseña
# DATABASE_URL=postgres://usuario:contraseña@host:5432/base

# --- Django ---
DJANGO_SECRET_KEY=genera-una-clave-larga-y-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Orígenes HTTPS desde los que se usa el admin (Railway añade su dominio automáticamente)
CSRF_TRUSTED_ORIGINS=
# URL del frontend que puede llamar a la API
CORS_ALLOWED_ORIGINS=http://localhost:3000
EVENT_CAPACITY=500

# Superuser creado automáticamente en cada despliegue si no existe
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@halloweenparadise.mx
DJANGO_SUPERUSER_PASSWORD=cambia-esta-contraseña

# --- Cloudinary (fotos de perfil y comprobantes) ---
# Cópiala de Cloudinary → Settings → API Keys ("API environment variable").
# Si se deja vacía, los archivos se guardan en disco.
CLOUDINARY_URL=
CLOUDINARY_FOLDER=halloween-paradise

# --- Frontend (se incrustan en el build: tras cambiarlas hay que redesplegar) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# Enlace al chat de la página de Facebook: https://m.me/<nombre-de-la-pagina>
NEXT_PUBLIC_MESSENGER_URL=https://m.me/halloweenparadise
# Enlace al DM de Instagram: https://ig.me/m/<usuario>
NEXT_PUBLIC_INSTAGRAM_URL=https://ig.me/m/halloweenparadise
